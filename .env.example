# Copy this file to .env.local and fill in the values from
# Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Called the "anon" or "publishable" key in the dashboard. Safe to expose; RLS protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only key for trusted server actions such as CAPTCHA-verified newsletter inserts. Never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where the site lives (used for metadataBase, sitemap, share links, sign-in redirects).
# Local: http://localhost:3000
# Production (Vercel): https://totallygonebananas.com  — never set a *.vercel.app URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" after enabling Google under Authentication > Providers.
NEXT_PUBLIC_AUTH_GOOGLE=false

# Cloudflare Turnstile CAPTCHA for sign-in, contact, newsletter, and recipe submissions.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend API key for the /about contact form and newsletter signup alerts (https://resend.com).
# Verify totallygonebananas.com in Resend so noreply@ sends successfully.
RESEND_API_KEY=
CONTACT_TO_EMAIL=noreply@totallygonebananas.com
CONTACT_FROM_EMAIL=Totally Gone Bananas <noreply@totallygonebananas.com>
# Copy of each footer newsletter signup (also stored in Admin → Newsletter).
NEWSLETTER_TO_EMAIL=newsletter@totallygonebananas.com

# Auto-post new recipes and blog posts to Facebook + Instagram (Meta Graph API, free).
# Leave META_PAGE_ID or META_PAGE_ACCESS_TOKEN blank to turn auto-posting off.
# The Page token needs pages_manage_posts, pages_read_engagement, instagram_basic, instagram_content_publish.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Instagram Business/Creator account ID linked to the Page (blank = Facebook only).
META_IG_USER_ID=
META_GRAPH_VERSION=v26.0

# Auto-post newly published recipes and posts to X (Twitter API v2, OAuth 1.0a user tokens).
# Create a project/app at https://developer.x.com with Read and Write, then generate user access tokens.
# Changing the app to Read and Write does not update old tokens. Regenerate them after the permission change.
# The same tokens upload the cover image. Leave any of these blank to turn X auto-posting off.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Auto-pin newly published recipes and blog posts (Pinterest API v5).
# 1) Create an app at https://developers.pinterest.com/
# 2) Add redirect URI: https://totallygonebananas.com/api/pinterest/callback
# 3) Set APP_ID + APP_SECRET below, redeploy, then connect at /admin/pinterest
# Optional env fallbacks if you prefer not to use the admin OAuth connection:
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_BOARD_ID=

# Auto-post newly published recipes, blog posts, and Our Faves to TikTok as photo posts.
# 1) Create an app at https://developers.tiktok.com/ with Login Kit and Content Posting API
# 2) Scopes: user.info.basic, video.publish
# 3) Redirect URI: https://totallygonebananas.com/api/tiktok/callback
# 4) Verify URL prefix https://totallygonebananas.com/ under Manage URL properties
# 5) Set the key and secret below, redeploy, then connect at /admin/tiktok
# Until TikTok audits the app, posts stay private on the connected account.
# Optional env fallbacks if you prefer not to use the admin OAuth connection:
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# /admin/analytics dashboard (Google Analytics Data API, free).
# Numeric GA4 property ID (Admin > Property details), not the G- measurement ID.
# The service account needs the Viewer role on the GA4 property.
GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
# Private key from the service account JSON, with newlines as \n.
GA_PRIVATE_KEY=

# Microsoft Clarity project ID (Settings > Overview in Clarity).
MICROSOFT_CLARITY_PROJECT_ID=
